{
  "name": "flowtodo",
  "main": "expo-router/entry",
  "version": "2.0.0-alpha",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:dev": "expo run:android --variant debug",
    "android:prod": "expo run:android --variant release",
    "android:clean": "expo prebuild --clean && expo run:android",
    "ios": "expo run:ios",
    "ios:dev": "expo run:ios --configuration Development",
    "ios:prod": "expo run:ios --configuration Release",
    "ios:clean": "expo prebuild --clean && expo run:ios",
    "web": "expo start --web",
    "web:export": "expo export -p web",
    "clean": "expo prebuild --clean",
    "test": "jest",
    "lint": "expo lint .",
    "typecheck": "tsc --noEmit",
    "types:gen": "supabase gen types typescript --local > types/database.ts"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.1.1",
    "@noble/ciphers": "^1.3.0",
    "@noble/hashes": "^2.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@supabase/supabase-js": "^2.118.0",
    "buffer": "^6.0.3",
    "expo": "^58.0.0",
    "expo-asset": "~58.0.21",
    "expo-audio": "~58.0.12",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-local-authentication": "~58.0.3",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.17",
    "expo-status-bar": "~58.0.5",
    "expo-web-browser": "~58.0.8",
    "lucide-react-native": "^1.66.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-quick-crypto": "^1.1.9",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-sortables": "^1.10.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "prettier": "^3.9.10",
    "react-test-renderer": "19.3.0",
    "supabase": "^2.122.1",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testTimeout": 15000,
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|lucide-react-native|react-native-sortables|@noble/.*)"
    ],
    "moduleNameMapper": {
      "^@/features/tasks/lib/store$": "<rootDir>/features/tasks/lib/store/index.remote.ts",
      "^@/features/pomodoro/lib/store$": "<rootDir>/features/pomodoro/lib/store/index.remote.ts",
      "^@/(.*)$": "<rootDir>/$1"
    }
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "expo-constants": "~58.0.16",
    "expo-font": "~58.0.12",
    "ws": "8.21.3"
  },
  "private": true
}
