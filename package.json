    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    }
  },
  "overrides": {
    "react-native-worklets": "0.5.1",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "private": true
